{
  "productName": "Video Cutter Pro",
  "version": "2.0.5",
  "identifier": "com.developer.videocutter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Video Cutter Pro - AI Smart Editor",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "externalBin": [
      "resources/ffmpeg",
      "resources/ffprobe",
      "resources/whisper",
      "resources/llama-vision",
      "resources/llama-cli"
    ],
    "resources": [
      "models/*"
    ]
  }
}
