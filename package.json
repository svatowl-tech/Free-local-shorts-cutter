{
  "name": "video-cutter-pro",
  "version": "2.0.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "postinstall": "node scripts/patch-sveltekit.js",
    "tauri": "tauri",
    "version:bump": "node scripts/bump-version.js",
    "download:binaries": "node scripts/download-resources.cjs",
    "generate:icons": "node scripts/generate-icons.js",
    "generate:ico": "node scripts/generate-icons.js",
    "package:portable": "node scripts/package-portable.js",
    "pretauri:dev": "npm run download:binaries && npm run generate:icons",
    "pretauri:build": "npm run download:binaries && npm run generate:icons",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:all": "npm run download:binaries && npm run generate:icons && npm run build && tauri build && npm run package:portable",
    "clean": "node -e \"const fs = require('fs'); ['build', 'dist', 'dist-releases', 'src-tauri/target', 'src-tauri/resources'].forEach(p => fs.rmSync(p, { recursive: true, force: true })); console.log('Build caches successfully cleaned up!');\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@lucide/svelte": "^1.21.0",
    "@tauri-apps/api": "~2.0.0",
    "@tauri-apps/plugin-dialog": "~2.0.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "clsx": "^2.1.1",
    "sharp": "^0.35.2",
    "tailwind-merge": "^3.3.1"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "esbuild": "^0.25.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.17.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "~2.0.0",
    "@types/node": "^20",
    "adm-zip": "^0.5.17",
    "autoprefixer": "^10.4.21",
    "eslint": "9.39.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "4.1.11",
    "to-ico": "^1.1.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^6.0.0"
  }
}
